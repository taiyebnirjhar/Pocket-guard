<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub build only: permissions Google Play restricts for this kind of app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One tap to exempt the guard from battery optimisation (Play allows only listed uses). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- SOS alerts go out by SMS by themselves (Play allows this only with an approved exception). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
</manifest>
